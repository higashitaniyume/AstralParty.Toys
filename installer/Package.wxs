<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="AstralParty.Toys" Manufacturer="higashitaniyume" Version="$(var.ProductVersion)" UpgradeCode="6B289420-9EE6-4D02-B437-A7AE244F904C" Scope="perUser" Language="2052" Codepage="936">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已安装更高版本的 AstralParty.Toys。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/higashitaniyume/AstralParty.Toys" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="STARTMENU_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="DESKTOP_SHORTCUT" Secure="yes" />
    <!-- Store unchecked as a nonempty sentinel: AppSearch cannot restore an empty property. -->
    <Property Id="SAVED_STARTMENU" Secure="yes">
      <RegistrySearch Id="PreviousStartMenu" Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="StartMenu" Type="raw" />
    </Property>
    <Property Id="SAVED_DESKTOP" Secure="yes">
      <RegistrySearch Id="PreviousDesktop" Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="Desktop" Type="raw" />
    </Property>
    <SetProperty Id="STARTMENU_SHORTCUT" Value="[ASTRAL_EMPTY_PROPERTY]" After="AppSearch" Sequence="first" Condition="SAVED_STARTMENU = &quot;0&quot;" />
    <SetProperty Id="DESKTOP_SHORTCUT" Value="1" After="AppSearch" Sequence="first" Condition="SAVED_DESKTOP = &quot;10&quot;" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AstralParty.Toys">
          <Component Id="InstallerSettings" Guid="*">
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveUserProgramsIfEmpty" Directory="UserPrograms" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="StartMenu" Type="string" Value="[STARTMENU_SHORTCUT]0" />
            <RegistryValue Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="Desktop" Type="string" Value="[DESKTOP_SHORTCUT]0" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="AstralParty.Toys">
        <Component Id="StartMenuShortcut" Guid="*" Condition="STARTMENU_SHORTCUT = &quot;1&quot;">
          <Shortcut Id="StartMenuLink" Name="AstralParty.Toys" Target="[INSTALLFOLDER]AstralParty.Toys.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="StartMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="DESKTOP_SHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopLink" Name="AstralParty.Toys" Target="[INSTALLFOLDER]AstralParty.Toys.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\AstralParty.Toys\Installer" Name="DesktopInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="AstralParty.Toys" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="InstallerSettings" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <UI>
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}快捷方式" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="选择需要为 AstralParty.Toys 创建的快捷方式。" />
        <Control Id="StartMenu" Type="CheckBox" X="25" Y="80" Width="320" Height="18" Property="STARTMENU_SHORTCUT" CheckBoxValue="1" Text="添加开始菜单快捷方式" />
        <Control Id="Desktop" Type="CheckBox" X="25" Y="108" Width="320" Height="18" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="添加桌面快捷方式" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutOptionsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutOptionsDlg" Order="3" Condition="NOT Installed" />
    </UI>
  </Package>
</Wix>
