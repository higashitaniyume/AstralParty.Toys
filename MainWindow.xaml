<Window x:Class="AstralParty.ReplayTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astral Replay · 吉星派对回放分析器"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#E8ECF8"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True" Drop="Window_Drop" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#131A2D" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1A2339" />
        <SolidColorBrush x:Key="LineBrush" Color="#26314E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A0BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="CyanBrush" Color="#43D6C5" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6F61E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9CA8C2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Margin="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252D4B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D2640" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#11182A" />
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="BorderBrush" Value="#26314E" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#202A44" />
            <Setter Property="RowBackground" Value="#11182A" />
            <Setter Property="AlternatingRowBackground" Value="#151D31" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2339" />
            <Setter Property="Foreground" Value="#AAB4CC" />
            <Setter Property="BorderBrush" Value="#26314E" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11182A" />
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="BorderBrush" Value="#2B3655" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10172A" BorderBrush="#222D48" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ASTRAL REPLAY" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="吉星派对 · 离线回放分析器" Foreground="#8996B2" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="32,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Text="尚未打开回放" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FilePathText" Text="可拖放文件到窗口" Foreground="#75819C" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExportButton" Content="导出 JSON" Margin="0,0,10,0" Background="#25304D" Click="ExportButton_Click" IsEnabled="False" />
                    <Button Content="打开回放" Click="OpenReplay_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="WelcomePanel" Margin="24" Style="{StaticResource PanelCard}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
                    <Border Width="88" Height="88" CornerRadius="24" Background="#28234C" Margin="0,0,0,22">
                        <TextBlock Text="✦" FontSize="48" Foreground="#A99FFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="把回放文件放到这里" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="离线解析对局摘要、玩家表现、事件时间线、筹码记录与原始协议。不会启动游戏，也不会联网。"
                               Foreground="#96A1BA" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,12,0,24" />
                    <Button Content="选择回放文件" Click="OpenReplay_Click" Padding="26,12" />
                    <TextBlock Text="也可以直接将无扩展名的回放缓存拖入窗口" Foreground="#65718C" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TabControl x:Name="ContentTabs" Visibility="Collapsed" Margin="18,12,18,8">
                <TabItem Header="对局摘要">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,14,6,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.9*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelCard}" Height="270" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding MapImagePath}" Stretch="UniformToFill" Opacity="0.78" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00212A43" Offset="0" />
                                                    <GradientStop Color="#F00B1020" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <StackPanel VerticalAlignment="Bottom" Margin="22">
                                            <TextBlock Text="地图图片预留位" Foreground="#9CA8C2" FontSize="11" />
                                            <TextBlock Text="{Binding MapName}" FontSize="28" FontWeight="Bold" />
                                            <TextBlock Text="{Binding MapId, StringFormat=地图 ID {0}}" Foreground="#AAB4CC" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="14,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="对局结果" Foreground="#94A0BA" />
                                                <TextBlock Text="{Binding ResultText}" FontSize="34" FontWeight="Bold" Foreground="#57E0B5" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding WinnerText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AwardsText}" HorizontalAlignment="Right" Foreground="#D4B66B" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,24,0,0">
                                            <StackPanel><TextBlock Text="时长" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DurationText}" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="回合" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding RoundCount}" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="关卡进度" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ProgressText}" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="死亡计数" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding PlayerDeaths}" Style="{StaticResource MetricValue}"/></StackPanel>
                                            <StackPanel><TextBlock Text="开始" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding StartTimeText}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                                            <StackPanel><TextBlock Text="结束" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding FinishTimeText}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                                            <StackPanel><TextBlock Text="难度" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Difficulty, StringFormat=难度 {0}}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                                            <StackPanel><TextBlock Text="最终 Boss" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding BossName}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="参战玩家" FontSize="20" FontWeight="SemiBold" Margin="2,24,0,12" />
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0" Padding="14">
                                            <StackPanel>
                                                <Border Height="112" CornerRadius="9" Background="#252E49" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                        <Border Background="#B012192B" VerticalAlignment="Bottom" Padding="8,4">
                                                            <TextBlock Text="{Binding HeroId, StringFormat=角色图片 · ID {0}}" HorizontalAlignment="Center" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Nickname}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,2" />
                                                <TextBlock Text="{Binding HeroName}" Foreground="#A99FFF" />
                                                <TextBlock Text="{Binding FinalStatus}" Foreground="#9AA6C0" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding SelectedRelicCount, StringFormat=已选择筹码：{0}}" Foreground="#56D6C8" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="玩家表现">
                    <Grid Margin="6,14,6,18">
                        <DataGrid ItemsSource="{Binding Players}" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="玩家" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel><TextBlock Text="{Binding Nickname}" FontWeight="SemiBold"/><TextBlock Text="{Binding IdentityText}" Foreground="#7F8BA6" FontSize="11"/></StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="角色" Binding="{Binding HeroName}" Width="100" />
                                <DataGridTextColumn Header="状态" Binding="{Binding FinalStatus}" Width="210" />
                                <DataGridTextColumn Header="HP" Binding="{Binding HpText}" Width="80" />
                                <DataGridTextColumn Header="星币" Binding="{Binding Gold}" Width="70" />
                                <DataGridTextColumn Header="攻/防" Binding="{Binding CombatText}" Width="65" />
                                <DataGridTextColumn Header="伤害" Binding="{Binding Damage}" Width="75" />
                                <DataGridTextColumn Header="承伤" Binding="{Binding Injured}" Width="75" />
                                <DataGridTextColumn Header="击杀" Binding="{Binding Kills}" Width="70" />
                                <DataGridTextColumn Header="治疗" Binding="{Binding Healing}" Width="70" />
                                <DataGridTextColumn Header="移动" Binding="{Binding MovePoints}" Width="70" />
                                <DataGridTextColumn Header="卡牌" Binding="{Binding UsedCards}" Width="70" />
                                <DataGridTextColumn Header="技能" Binding="{Binding UsedSkills}" Width="70" />
                                <DataGridTextColumn Header="购买筹码" Binding="{Binding BoughtRelics}" Width="90" />
                                <DataGridCheckBoxColumn Header="Boss 最后一击" Binding="{Binding FinalBossKill}" Width="105" />
                                <DataGridTextColumn Header="已选筹码" Binding="{Binding SelectedRelicsText}" Width="420" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="事件时间线">
                    <Grid Margin="6,14,6,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="按事件、玩家、回合或描述筛选" Foreground="#8995AE" VerticalAlignment="Center" />
                            <TextBox x:Name="EventFilterBox" DockPanel.Dock="Right" Width="320" Margin="16,0,0,0" TextChanged="EventFilterBox_TextChanged" />
                        </DockPanel>
                        <DataGrid x:Name="EventsGrid" Grid.Row="1" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="图" Width="58">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Width="36" Height="36"><Border Background="#26304B" CornerRadius="8"/><Image Source="{Binding IconPath}" Stretch="UniformToFill"/><TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8E83E8"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="帧" Binding="{Binding FrameIndex}" Width="70" />
                                <DataGridTextColumn Header="回合" Binding="{Binding RoundText}" Width="95" />
                                <DataGridTextColumn Header="玩家/实体" Binding="{Binding PlayerName}" Width="150" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" />
                                <DataGridTextColumn Header="事件" Binding="{Binding Title}" Width="220" />
                                <DataGridTextColumn Header="详情" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="筹码记录">
                    <Grid Margin="6,14,6,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="候选包按 Action.Sn 去重；选择与刷新来自服务器回执。图片路径：Assets/Relics/&lt;ID&gt;.png" Foreground="#8995AE" />
                            <TextBox x:Name="RelicFilterBox" DockPanel.Dock="Right" Width="280" TextChanged="RelicFilterBox_TextChanged" />
                        </DockPanel>
                        <DataGrid x:Name="RelicsGrid" Grid.Row="1" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="图片" Width="70">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Width="48" Height="48"><Border Background="#252E49" CornerRadius="8"/><Image Source="{Binding ImagePath}" Stretch="UniformToFill"/><TextBlock Text="{Binding RelicId}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="9" Background="#990B1020"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="帧" Binding="{Binding FrameIndex}" Width="70" />
                                <DataGridTextColumn Header="回合" Binding="{Binding Round}" Width="65" />
                                <DataGridTextColumn Header="玩家" Binding="{Binding PlayerName}" Width="150" />
                                <DataGridTextColumn Header="记录" Binding="{Binding Kind}" Width="70" />
                                <DataGridTextColumn Header="等级" Binding="{Binding LevelText}" Width="65" />
                                <DataGridTextColumn Header="筹码" Binding="{Binding RelicName}" Width="180" />
                                <DataGridTextColumn Header="品质" Binding="{Binding Quality}" Width="70" />
                                <DataGridTextColumn Header="候选内容" Binding="{Binding OptionsText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="原始协议">
                    <Grid Margin="6,14,6,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox x:Name="FrameFilterBox" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10" TextChanged="FrameFilterBox_TextChanged" />
                        <TextBlock Grid.Column="1" Text="选择左侧帧查看 protobuf JSON；未注册命令显示十六进制。" Foreground="#8995AE" Margin="14,8,0,10" />
                        <DataGrid x:Name="FramesGrid" Grid.Row="1" SelectionChanged="FramesGrid_SelectionChanged" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="帧" Binding="{Binding Index}" Width="65" />
                                <DataGridTextColumn Header="偏移" Binding="{Binding OffsetText}" Width="105" />
                                <DataGridTextColumn Header="CMD" Binding="{Binding CmdId}" Width="70" />
                                <DataGridTextColumn Header="消息" Binding="{Binding MessageName}" Width="*" />
                                <DataGridTextColumn Header="字节" Binding="{Binding PayloadLength}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelCard}" Margin="14,0,0,0" Padding="0">
                            <TextBox x:Name="RawDetailText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="统计信息">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="6,14,6,24">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="协议命令频率" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding CommandStats}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Height="8" Background="#252E49" CornerRadius="4" Margin="8,5"><Border Width="{Binding BarWidth}" Background="#8173F0" CornerRadius="4" HorizontalAlignment="Left"/></Border><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#9AA6C0" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="去重行动频率" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <ItemsControl ItemsSource="{Binding ActionStats}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Height="8" Background="#252E49" CornerRadius="4" Margin="8,5"><Border Width="{Binding BarWidth}" Background="#42CDBC" CornerRadius="4" HorizontalAlignment="Left"/></Border><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#9AA6C0" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                                    <StackPanel><TextBlock Text="筹码选择品质" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <ItemsControl ItemsSource="{Binding RelicQualityStats}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><Border Grid.Column="1" Height="10" Background="#252E49" CornerRadius="5" Margin="8,4"><Border Width="{Binding BarWidth}" Background="#D49C62" CornerRadius="5" HorizontalAlignment="Left"/></Border><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#9AA6C0" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Text="文件与解析" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FormatText}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding FileSizeText}" Foreground="#9AA6C0" Margin="0,5,0,0" />
                                        <TextBlock Text="SHA-256" Foreground="#9AA6C0" Margin="0,14,0,3" />
                                        <TextBlock Text="{Binding Sha256}" FontFamily="Consolas" TextWrapping="Wrap" FontSize="11" />
                                        <TextBlock Text="{Binding WarningCount, StringFormat=解析警告：{0}}" Foreground="#E4B86C" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#D90B1020">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="280" Height="5" Foreground="#8B7CFF" />
                    <TextBlock x:Name="BusyText" Text="正在读取回放…" HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="15" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E1526" BorderBrush="#202A42" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="#8894AD" />
                <TextBlock DockPanel.Dock="Right" Text="离线模式 · 大端帧格式 · protobuf" VerticalAlignment="Center" Foreground="#5F6B84" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
