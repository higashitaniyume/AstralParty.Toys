<Window x:Class="AstralParty.Toys.SpeedhackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏工具 · 变速器管理"
        Width="960" Height="820" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020" Foreground="#E8ECF8"
        FontFamily="Segoe UI, Microsoft YaHei UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#131A2D" />
        <SolidColorBrush x:Key="LineBrush" Color="#26314E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A0BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="PinkBrush" Color="#FF1776" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6F61E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#11182A" />
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="BorderBrush" Value="#26314E" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#343D67" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252E49" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11182A" />
            <Setter Property="Foreground" Value="#E8ECF8" />
            <Setter Property="BorderBrush" Value="#2B3655" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="⚡ 游戏加速 · 变速器" FontSize="20" FontWeight="Bold" />
                <Border x:Name="StateBadge" Background="#33271B" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StateBadgeText" Text="未检测" FontSize="12" FontWeight="Bold" Foreground="#E4B86C" />
                </Border>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                       Text="修改游戏进程时间函数 · 请勿用于联机对局" />
        </DockPanel>

        <!-- 安装区 -->
        <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="安装 / 卸载" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏目录" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="GameDirBox" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="自动检测" Background="#25304D" Click="DetectDirButton_Click" Margin="0,0,8,0" />
                        <Button Content="选择…" Background="#25304D" Click="BrowseDirButton_Click" Margin="0,0,8,0" />
                        <Button Content="打开目录" Background="#25304D" Click="OpenDirButton_Click" Margin="0,0,8,0" />
                        <Button x:Name="InstallButton" Content="⚡ 安装" Background="{StaticResource PinkBrush}" Click="InstallButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusText" Text="正在检测…" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" />

                <WrapPanel Margin="0,12,0,0">
                    <CheckBox x:Name="OverwriteCheck" Content="覆盖目录里其它 version.dll" Margin="0,0,18,0" Foreground="#AAB4CC" />
                    <CheckBox x:Name="ForceUninstallCheck" Content="强制卸载（不校验哈希）" Foreground="#AAB4CC" />
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="PushConfigButton" Content="↻ 同步配置到游戏" Background="#25304D" Click="PushConfigButton_Click" IsEnabled="False" />
                    <Button x:Name="UninstallButton" Content="🗑 卸载变速器" Background="#7F1D2E" Click="UninstallButton_Click" Margin="10,0,0,0" />
                    <TextBlock Text="提示：安装 / 卸载前请先退出游戏；变速需在游戏内关闭垂直同步；改完配置重启游戏或按 Ctrl+Shift+R 重载。"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="420" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 配置区 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" Text="speedhack_config.json 配置" />
                            <Button DockPanel.Dock="Right" Content="用编辑器打开 JSON" Background="#25304D" Click="EditJsonButton_Click" />
                            <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="进入游戏自动倍速" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="AutoSpeedEnableCheck" Content="启用" Foreground="#E8ECF8" VerticalAlignment="Center"
                                          Checked="AutoSpeedEnable_Changed" Unchecked="AutoSpeedEnable_Changed" />
                                <TextBox x:Name="BaseSpeedBox" Width="90" Margin="12,0,0,0" Text="2" />
                                <TextBlock Text="倍速" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="每次进入游戏自动启用，无需按快捷键" Style="{StaticResource FieldHint}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="调试控制台 console" Style="{StaticResource FieldLabel}" Margin="0,10,14,0" />
                            <CheckBox x:Name="ConsoleCheck" Grid.Row="1" Grid.Column="1" Content="显示日志控制台窗口" Foreground="#E8ECF8" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="排查时再开启" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="挂接延迟 wait_with_hook" Style="{StaticResource FieldLabel}" Margin="0,10,14,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="WaitMsBox" Width="90" Text="250" />
                                <TextBlock Text="毫秒" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="进游戏后延迟挂接，防崩溃" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="启动加速 startup_state" Style="{StaticResource FieldLabel}" Margin="0,10,14,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="StartupEnableCheck" Content="启用" Foreground="#E8ECF8" VerticalAlignment="Center" Checked="StartupEnable_Changed" Unchecked="StartupEnable_Changed" />
                                <TextBox x:Name="StartupSpeedBox" Width="70" Text="10" Margin="10,0,0,0" />
                                <TextBlock Text="倍速" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
                                <TextBox x:Name="StartupDurationBox" Width="70" Text="5" Margin="14,0,0,0" />
                                <TextBlock Text="秒" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="跳过开场动画用（结束后恢复）" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />
                        </Grid>

                        <Separator Margin="0,16,0,6" Opacity="0.3" />
                        <TextBlock Text="倍速档位（组合按键达到时切换速度）" Style="{StaticResource FieldLabel}" Margin="0,8,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <ListBox x:Name="StatesList" Height="150" Background="#11182A" Foreground="#E8ECF8" BorderBrush="{StaticResource LineBrush}"
                                         SelectionChanged="StatesList_SelectionChanged" FontSize="13" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="＋ 添加档位" Background="#25304D" Click="AddStateButton_Click" />
                                    <Button Content="删除选中" Background="#7F1D2E" Click="RemoveStateButton_Click" Margin="8,0,0,0" />
                                    <Button x:Name="ApplyStateButton" Content="应用到选中档位" Background="#25304D" Click="ApplyStateButton_Click" Margin="8,0,0,0" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0E1424" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="档位编辑（选择左侧档位后修改）" Style="{StaticResource FieldHint}" Margin="0,0,0,8" />
                                    <TextBlock Text="按键组合" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="StateKeysBox" Margin="0,4,0,0" Text="VK_CONTROL" FontFamily="Consolas" FontSize="12" />
                                    <TextBlock Text="多个键用英文逗号分隔，如 VK_CONTROL,VK_SHIFT" FontSize="10" Foreground="#5F6B84" Margin="0,3,0,8" />
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="倍速" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="StateSpeedBox" Width="80" HorizontalAlignment="Right" Text="2" />
                                    </DockPanel>
                                    <CheckBox x:Name="StateToggleCheck" Content="点按切换（不勾选 = 按住生效）" Margin="0,10,0,0" Foreground="#AAB4CC" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Separator Margin="0,14,0,6" Opacity="0.3" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="重载配置热键 reload_config_keys" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReloadKeysBox" Width="300" HorizontalAlignment="Left" Text="VK_CONTROL,VK_SHIFT,VK_R" FontFamily="Consolas" FontSize="12" />
                        </DockPanel>
                        <TextBlock Text="逗号分隔的 VK 键名；游戏内按此组合立即重新读取配置文件" Style="{StaticResource FieldHint}" Margin="150,4,0,0" />

                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="SaveConfigButton" DockPanel.Dock="Right" Content="💾 保存配置" Background="{StaticResource PinkBrush}" Click="SaveConfigButton_Click" />
                            <Button DockPanel.Dock="Right" Content="恢复默认模板" Background="#25304D" Click="RestoreConfigButton_Click" Margin="0,0,10,0" />
                            <TextBlock x:Name="SaveHintText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Text="未保存的修改不会生效" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="工具来源 github.com/Hirtol/speedhack-rs · 仅用于单机研究与观察" Foreground="#5F6B84" FontSize="10" Margin="4,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
