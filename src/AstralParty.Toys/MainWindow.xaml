<Window x:Class="AstralParty.Toys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstralParty.Toys · 需要安装 WebView2 运行时"
        Width="820" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#E8ECF8"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#131A2D" />
        <SolidColorBrush x:Key="LineBrush" Color="#26314E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A0BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6F61E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10172A" BorderBrush="#222D48" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ASTRAL PARTY TOYS" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="吉星派对 · 本地工具箱" Foreground="#8996B2" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,20" MaxWidth="720" HorizontalAlignment="Center">
                <Border Style="{StaticResource PanelCard}" Padding="28,26">
                    <StackPanel>
                        <Border Width="76" Height="76" CornerRadius="22" Background="#2A2440" Margin="0,0,0,18"
                                HorizontalAlignment="Left">
                            <TextBlock Text="⚠" FontSize="38" Foreground="#E4B86C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="这台电脑缺少 WebView2 运行时" Foreground="White" FontSize="26" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="1.7">
                            工具箱的界面是用 Microsoft Edge WebView2 运行时渲染的。这台电脑上没装（或版本太旧），界面没法显示。
                            装好之后重新打开本程序就能正常用了。
                        </TextBlock>

                        <Border Background="#10182B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="怎么装" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="1.7">
                                    <Run Text="1. 点下面的「下载 WebView2 Runtime」，浏览器会打开微软官方的下载页。" />
                                    <LineBreak />
                                    <Run Text="2. 下载页里选「Evergreen Bootstrapper」（几十 MB 的小安装包），下载后双击安装，一路下一步就行。" />
                                    <LineBreak />
                                    <Run Text="3. 装完关掉这个窗口，重新打开 AstralParty.Toys。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ErrorText" Foreground="#C9A05E" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"
                                   Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="下载 WebView2 Runtime" Click="DownloadButton_Click" Padding="22,11" />
                            <Button Content="重新打开本程序" Click="RestartButton_Click" Margin="12,0,0,0"
                                    Padding="22,11" Background="#25304D" />
                            <Button Content="退出" Click="ExitButton_Click" Margin="12,0,0,0"
                                    Padding="22,11" Background="#25304D" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="1.6">
                            公司内网或没有外网的话，用微软提供的离线安装包（Evergreen Standalone Installer）也可以，
                            官方页面同样能下。装不动的话，先看看这台电脑是不是被安全软件拦住了。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0E1526" BorderBrush="#202A42" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0">
                <!-- DockPanel 按声明顺序停靠：右对齐的先写，否则它会被后面那个占满剩余空间的挤没 -->
                <TextBlock DockPanel.Dock="Right" Text="AstralParty.Toys · 本地工具箱" VerticalAlignment="Center"
                           Foreground="#5F6B84" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusText" Text="等待安装 WebView2 运行时" VerticalAlignment="Center" Foreground="#8894AD"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
