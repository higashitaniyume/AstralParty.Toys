<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="BuiltInMods.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x86</Platforms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AstralParty.Toys</AssemblyName>
    <RootNamespace>AstralParty.Toys</RootNamespace>
    <StartupObject>AstralParty.Toys.App</StartupObject>
    <!-- v1.2.13 正式发布，程序与安装器数字版本均为 1.2.13。 -->
    <Version>1.2.13</Version>
    <AssemblyVersion>1.2.13.0</AssemblyVersion>
    <FileVersion>1.2.13.0</FileVersion>
    <ApplicationIcon>WebUI\images\UT_AccountHeadShot_70902.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResourceModEngine\ResourceModEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Addressables" Version="3.0.2" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SpeedhackTools\version.dll;Resources\SpeedhackTools\speedhack_config.json">
      <LogicalName>AstralParty.Toys.SpeedhackTools.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 内置加载器组件: 加载器/SDK/内置 mod 的 sidecar 都以「内嵌资源」编译进程序集。
         更新方式: 用 CesiumLoader 仓库的 tools\package-modloader.ps1 打包后, 把包内
         version.dll / sdk\CesiumLoader.SDK.dll / mods\{ModId}\* 覆盖到 Resources\ModLoader\,
         loader-version.json 写包内 cesium-loader.json 的 version。CI 也会在打 tag 时自动同步
         (.github/workflows/release.yml 的 "Fetch latest CesiumLoader package")。 -->
    <!-- 加载器/SDK/配置模板/版本与日志: 固定文件, 显式列出。 -->
    <EmbeddedResource Include="Resources\ModLoader\version.dll;Resources\ModLoader\doorstop_config.json;Resources\ModLoader\CesiumLoader.SDK.dll;Resources\ModLoader\loader-version.json;Resources\ModLoader\loader-changelog.md">
      <LogicalName>AstralParty.Toys.ModLoader.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 内置资源仅来自 BuiltInMods.props 中的公开分发清单。 -->
    <EmbeddedResource Include="Resources\Skins\character-image-sizes.json" LogicalName="AstralParty.Toys.CharacterImageSizes.json" />
    <EmbeddedResource Include="Resources\Skins\default-skins.zip">
      <LogicalName>AstralParty.Toys.DefaultSkins.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="@(BuiltInMod->'Resources\ModLoader\%(Identity).dll');@(BuiltInMod->'Resources\ModLoader\%(Identity).json')">
      <LogicalName>AstralParty.Toys.ModLoader.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 模组数据包（语言翻译等）：资源名 data.{ModId}.{文件名}，安装时写到 mods\{ModId}\data\。 -->
    <EmbeddedResource Include="Resources\ModLoader\data\LanguageUnlockMod\*">
      <LogicalName>AstralParty.Toys.ModLoader.data.LanguageUnlockMod.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Protocol\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GameData\Version.bin;GameData\Skin.bin;GameData\STRSkin.bin;GameData\Character.bin;GameData\STRCharacter.bin;GameData\Map.bin;GameData\STRMap.bin;GameData\Monster.bin;GameData\STRMonster.bin;GameData\Relic.bin;GameData\STRRelic.bin;GameData\Item.bin;GameData\STRItem.bin;GameData\Card.bin;GameData\STRCard.bin;GameData\Event.bin;GameData\STREvent.bin;GameData\Destiny.bin;GameData\STRDestiny.bin;GameData\MapEvent.bin;GameData\STRMapEvent.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="WebUI\images\UT_AccountHeadShot_70902.ico" />
    <None Update="Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.webp;Assets\**\*.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 前端页面内嵌进 exe：发布目录不再带 WebUI 文件夹，运行时由 EmbeddedWebStore 直接提供。
         LogicalName 保留原始相对路径（默认命名会把 css/base.css 压成 css.base.css，无法还原）。
         开发时若 exe 同目录存在 WebUI\index.html，则优先走磁盘映射，改完刷新即可见效。 -->
    <EmbeddedResource Include="WebUI\**\*">
      <LogicalName>AstralParty.Toys.WebUI/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PackedAssets\**\*.webp;PackedAssets\**\*.png" />
    <!-- 仓库根的 CHANGELOG.md 编译进程序集，供「关于 → 更新日志」在程序内展示（宿主读它回推给前端）。 -->
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>AstralParty.Toys.CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 让测试项目能直接驱动 internal 的实现细节（例如交给 WebView2 的响应流包装） -->
  <ItemGroup>
    <InternalsVisibleTo Include="AstralParty.Toys.Tests" />
  </ItemGroup>
</Project>

