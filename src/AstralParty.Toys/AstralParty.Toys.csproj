<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x86</Platforms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AstralParty.Toys</AssemblyName>
    <RootNamespace>AstralParty.Toys</RootNamespace>
    <StartupObject>AstralParty.Toys.App</StartupObject>
    <!-- 与发布 tag 同步递增：v0.1.0 → v0.2.0（商店候选/购买回放时间线） -->
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <ApplicationIcon>WebUI\images\UT_AccountHeadShot_70902.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SpeedhackTools\version.dll;Resources\SpeedhackTools\speedhack_config.json">
      <LogicalName>AstralParty.Toys.SpeedhackTools.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ModLoader\version.dll;Resources\ModLoader\doorstop_config.json;Resources\ModLoader\CesiumLoader.SDK.dll;Resources\ModLoader\ActivityLogMod.dll;Resources\ModLoader\ActivityLogMod.json;Resources\ModLoader\SpeedHackMod.dll;Resources\ModLoader\SpeedHackMod.json;Resources\ModLoader\loader-version.json">
      <LogicalName>AstralParty.Toys.ModLoader.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Protocol\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GameData\Character.bin;GameData\STRCharacter.bin;GameData\Map.bin;GameData\STRMap.bin;GameData\Monster.bin;GameData\STRMonster.bin;GameData\Relic.bin;GameData\STRRelic.bin;GameData\Item.bin;GameData\STRItem.bin;GameData\Card.bin;GameData\STRCard.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="WebUI\images\UT_AccountHeadShot_70902.ico" />
    <None Update="Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.webp;Assets\**\*.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 前端页面内嵌进 exe：发布目录不再带 WebUI 文件夹，运行时由 EmbeddedWebStore 直接提供。
         LogicalName 保留原始相对路径（默认命名会把 css/base.css 压成 css.base.css，无法还原）。
         开发时若 exe 同目录存在 WebUI\index.html，则优先走磁盘映射，改完刷新即可见效。 -->
    <EmbeddedResource Include="WebUI\**\*">
      <LogicalName>AstralParty.Toys.WebUI/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PackedAssets\**\*.webp;PackedAssets\**\*.png" />
  </ItemGroup>

  <!-- 让测试项目能直接驱动 internal 的实现细节（例如交给 WebView2 的响应流包装） -->
  <ItemGroup>
    <InternalsVisibleTo Include="AstralParty.Toys.Tests" />
  </ItemGroup>
</Project>
