<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AstralParty.Toys</AssemblyName>
    <RootNamespace>AstralParty.Toys</RootNamespace>
    <StartupObject>AstralParty.Toys.App</StartupObject>
    <!-- v2.4.4，程序与安装器数字版本为 2.4.4。 -->
    <Version>2.4.4</Version>
    <AssemblyVersion>2.4.4.0</AssemblyVersion>
    <FileVersion>2.4.4.0</FileVersion>
    <ApplicationIcon>WebUI\images\UT_AccountHeadShot_70902.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResourceModEngine\ResourceModEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Addressables" Version="3.0.2" />
    <PackageReference Include="AssetsTools.NET.Texture" Version="3.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SpeedhackTools\version.dll;Resources\SpeedhackTools\speedhack_config.json">
      <LogicalName>AstralParty.Toys.SpeedhackTools.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 内置加载器组件 = **整个 CesiumLoader 发布包**（cesium-loader.zip），一个内嵌资源搞定。
         「安装 / 重新安装内置版本」与「导入发布包」走同一条代码路径：先按包内 cesium-loader.json
         校验哈希，再按包内布局解压（version.dll / SDK / bootstrap / mods（含 sidecar、data、sounds、pdb）
         / doorstop 模板 / NOTICE、LICENSE、README、CHANGELOG）。
         包内版本号、SDK 版本、内置 mod 清单与加载器更新日志都由 ModManager 直接从包里读，所以
         不存在第二份需要同步的清单。
         更新方式：用 CesiumLoader 仓库的 tools\package-modloader.ps1 产出 cesium-loader.zip，
         拷成 Resources\ModLoader\cesium-loader.zip；CI 打 tag 时会自动换成最新 Release 的包
         (.github/workflows/release.yml 的 "Fetch latest CesiumLoader package")。 -->
    <EmbeddedResource Include="Resources\ModLoader\cesium-loader.zip">
      <LogicalName>AstralParty.Toys.ModLoader.cesium-loader.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Skins\character-image-sizes.json" LogicalName="AstralParty.Toys.CharacterImageSizes.json" />
    <EmbeddedResource Include="Resources\AudioCatalog.json" LogicalName="AstralParty.Toys.AudioCatalog.json" />
    <!-- 第三方模组「自定义主页背景」（TenkinMori，MIT）：不进加载器内置清单（发布流程会从 CesiumLoader 发布包同步那份清单），
         由「自定义 → 主页背景」第一次设置时装进游戏。说明见 Resources\ThirdPartyMods\HomeBackgroundMod\README.md。 -->
    <EmbeddedResource Include="Resources\ThirdPartyMods\HomeBackgroundMod\*" Exclude="Resources\ThirdPartyMods\HomeBackgroundMod\README.md;Resources\ThirdPartyMods\HomeBackgroundMod\*.patch">
      <LogicalName>AstralParty.Toys.ThirdParty.HomeBackgroundMod.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Protocol\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GameData\Version.bin;GameData\Skin.bin;GameData\STRSkin.bin;GameData\Character.bin;GameData\STRCharacter.bin;GameData\Map.bin;GameData\STRMap.bin;GameData\Monster.bin;GameData\STRMonster.bin;GameData\Relic.bin;GameData\STRRelic.bin;GameData\Item.bin;GameData\STRItem.bin;GameData\Card.bin;GameData\STRCard.bin;GameData\Event.bin;GameData\STREvent.bin;GameData\Destiny.bin;GameData\STRDestiny.bin;GameData\MapEvent.bin;GameData\STRMapEvent.bin;GameData\Achieve.bin;GameData\STRAchieve.bin;GameData\Player.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="WebUI\images\UT_AccountHeadShot_70902.ico" />
    <None Update="Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.webp;Assets\**\*.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 前端页面内嵌进 exe：发布目录不再带 WebUI 文件夹，运行时由 EmbeddedWebStore 直接提供。
         LogicalName 保留原始相对路径（默认命名会把 css/base.css 压成 css.base.css，无法还原）。
         开发时若 exe 同目录存在 WebUI\index.html，则优先走磁盘映射，改完刷新即可见效。 -->
    <EmbeddedResource Include="WebUI\**\*">
      <LogicalName>AstralParty.Toys.WebUI/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PackedAssets\**\*.webp;PackedAssets\**\*.png" />
    <!-- 仓库根的 CHANGELOG.md 编译进程序集，供「关于 → 更新日志」在程序内展示（宿主读它回推给前端）。 -->
    <EmbeddedResource Include="..\..\CHANGELOG.md">
      <LogicalName>AstralParty.Toys.CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 让测试项目能直接驱动 internal 的实现细节（例如交给 WebView2 的响应流包装） -->
  <ItemGroup>
    <InternalsVisibleTo Include="AstralParty.Toys.Tests" />
  </ItemGroup>
</Project>

