<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Astral Party · 吉星派对助手与回放工具</title>
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/home.css">
  <link rel="stylesheet" href="css/tools.css">
  <link rel="stylesheet" href="css/wiki.css">
  <link rel="stylesheet" href="css/settings.css">
</head>
<body>
  <div class="app-shell">
    <!-- Global Header -->
    <header class="global-header">
      <div class="brand-section" id="brandLogoBtn">
        <div class="brand-logo">✦</div>
        <div class="brand-text">
          <h1>ASTRAL PARTY</h1>
          <small>REPLAY &amp; COMPANION TOOL</small>
        </div>
      </div>

      <nav class="nav-breadcrumbs">
        <button class="nav-crumb-btn active" data-page="home"><span>🏠</span>首页</button>
        <button class="nav-crumb-btn" data-page="wiki"><span>📖</span>攻略/维基</button>
        <button class="nav-crumb-btn" data-page="tools"><span>⚙️</span>工具</button>
        <button class="nav-crumb-btn" data-page="settings"><span>🔧</span>设置</button>
      </nav>

      <div class="header-status">
        <div class="status-badge">
          <span class="status-dot"></span>
          <span id="runtimeBadgeText">离线模式 · 本地解析</span>
        </div>
      </div>
    </header>

    <!-- Main Views Container -->
    <main class="page-container">
      <!-- 1. HOME VIEW (In-Game Aesthetic Main Lobby) -->
      <section id="homeView" class="page-view home-page in-game-lobby">
        <!-- Full-Screen Hero Character Stage (Canvas) -->
        <div class="lobby-hero-stage" id="heroPortraitWrapper" title="点击角色互动 / 切换台词">
          <div class="lobby-stage-glow"></div>
          <img id="heroPortraitImg" class="lobby-hero-art" src="https://assets.astral.local/Portraits/UT_Hero_Card_102_01.webp" alt="芬妮">

          <!-- Character Speech Bubble -->
          <div class="hero-dialog-bubble" id="heroDialogBubble" title="点击对话框刷新台词">
            <div class="bubble-header">
              <span class="bubble-speaker">✦ <span id="bubbleSpeakerName">芬妮</span></span>
              <span class="bubble-hint">点我互动 💬</span>
            </div>
            <p class="bubble-text" id="bubbleSpeechText">只要报酬丰厚……啊不是，古怪神探芬妮随时准备出击！</p>
          </div>
        </div>

        <!-- Top-Left CLEARPASS Icon Button -->
        <div class="lobby-top-left">
          <button class="lobby-clearpass-btn" id="btnHomeClearPass" title="小红帽通行证 CLEARPASS">
            <div class="clearpass-frame">
              <img src="https://assets.astral.local/UI/UT_BattlePass_202609_Icon.webp" alt="CLEARPASS">
            </div>
            <span class="clearpass-text">CLEARPASS</span>
          </button>
        </div>

        <!-- Left Middle / Bottom Event Banners -->
        <div class="lobby-left-events">
          <!-- Circular Event Entrance Badge -->
          <button class="lobby-event-circle" id="btnEventTrial" title="09.03-10.14 魔法少女的魔女审判">
            <img src="https://assets.astral.local/UI/UT_Activity_202609031_Entrance.webp" alt="魔法少女的魔女审判">
          </button>

          <!-- Banner Cards (Side-by-side) -->
          <div class="lobby-banners-row">
            <button class="lobby-banner-box banner-pass" id="btnBannerPass" title="超值礼物等你获取！小红帽通行证">
              <img src="https://assets.astral.local/UI/UT_BattlePass_202609_EntranceUnfold.webp" alt="小红帽通行证">
            </button>
            <button class="lobby-banner-box banner-shop" id="btnBannerShop" title="魔女商店 (09.03-10.14)">
              <img src="https://assets.astral.local/UI/UT_Banner_609030.webp" alt="魔女商店">
            </button>
          </div>
        </div>

        <!-- Right Side Main Menu Buttons -->
        <div class="lobby-right-menu">
          <!-- 1. 角色 (Role) -->
          <button class="lobby-card-btn card-role" id="btnMenuRole" title="角色图鉴与属性">
            <div class="card-btn-text">角色</div>
            <img class="card-btn-chibi" src="https://assets.astral.local/UI/UT_Hero_LevelUp_114_01.webp" alt="角色">
          </button>

          <!-- 2. 商城 (Shop) -->
          <button class="lobby-card-btn card-shop" id="btnMenuShop" title="游戏商城">
            <div class="card-btn-text">商城</div>
            <img class="card-btn-chibi" src="https://assets.astral.local/UI/UT_Hero_LevelUp_108_01.webp" alt="商城">
          </button>

          <!-- 3. 抽奖 (Lottery / Gacha) -->
          <button class="lobby-card-btn card-gacha" id="btnMenuGacha" title="星之抽奖">
            <div class="card-btn-badge">UP!</div>
            <div class="card-btn-text">抽奖</div>
            <img class="card-btn-chibi" src="https://assets.astral.local/UI/UT_Hero_LevelUp_107_01.webp" alt="抽奖">
          </button>

          <!-- 4. 活动 (Activity) -->
          <button class="lobby-card-btn card-activity" id="btnMenuActivity" title="活动与公告">
            <div class="card-btn-text">活动</div>
            <img class="card-btn-chibi" src="https://assets.astral.local/UI/UT_Hero_LevelUp_102_01.webp" alt="活动">
          </button>

          <!-- 5. 开始游戏 (Primary Play Button) -->
          <button class="lobby-start-game-btn" id="btnStartGame" title="进入对局回放与分析工具">
            <div class="start-game-dice-wrap">
              <img src="https://assets.astral.local/UI/UT_Item_Dice_72001.webp" alt="骰子" class="start-game-dice">
            </div>
            <span class="start-game-text">开始游戏</span>
          </button>
        </div>

        <!-- Center-Right Floating HUD Controls -->
        <div class="lobby-hud-controls">
          <button class="hud-mini-btn" id="btnResetView" title="重置视角">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 2v20M2 12h20M7 7l5-5 5 5M7 17l5 5 5-5M17 7l5 5-5 5M7 7l-5 5 5 5"/>
            </svg>
          </button>
          <button class="hud-mini-btn" id="btnToggleHud" title="欣赏立绘 / 切换界面显隐">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
            </svg>
          </button>
          <button class="hud-fashion-tile" id="btnSwitchHeroDress" title="装扮 · 切换看板立绘">
            <div class="fashion-shirt-icon">👕</div>
            <span class="fashion-text">装扮</span>
          </button>
        </div>

        <!-- Bottom In-Game Dock Bar -->
        <footer class="lobby-bottom-dock">
          <!-- Left: Player Profile Strip -->
          <div class="dock-profile-widget">
            <div class="dock-avatar-frame">
              <img src="https://assets.astral.local/UI/UT_AccountHeadShot_70001.webp" alt="头像" class="dock-pixel-avatar">
            </div>
            <div class="dock-namecard-box">
              <img src="https://assets.astral.local/UI/UT_AccountBackground_114_01.webp" alt="名片" class="dock-namecard-bg">
              <div class="dock-player-labels">
                <span class="dock-player-lvl">Lv.<b>19</b></span>
                <span class="dock-player-name">企鹅鹅大魔王</span>
              </div>
            </div>
            <div class="dock-exp-track" title="当前经验值 130 / 380">
              <div class="dock-exp-fill" style="width: 34.2%;"></div>
              <span class="dock-exp-text">130/380</span>
            </div>
          </div>

          <!-- Center: Currencies -->
          <div class="dock-currencies">
            <div class="dock-currency-pill">
              <img src="https://assets.astral.local/UI/UT_Item_Currency_2.webp" alt="星晶" class="dock-currency-img">
              <span class="dock-currency-num">7545</span>
              <span class="dock-currency-add">+</span>
            </div>
            <div class="dock-currency-pill">
              <img src="https://assets.astral.local/UI/UT_Item_Currency_1.webp" alt="星币" class="dock-currency-img">
              <span class="dock-currency-num">0</span>
              <span class="dock-currency-add">+</span>
            </div>
          </div>

          <!-- Right: Action Icons -->
          <nav class="dock-actions-nav">
            <button class="dock-nav-item" id="dockBtnTask" title="任务">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
              <span>任务</span>
            </button>
            <button class="dock-nav-item" id="dockBtnFriend" title="好友">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 3s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
              <span>好友</span>
            </button>
            <button class="dock-nav-item" id="dockBtnNotice" title="游戏公告">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z"/></svg>
              <span>公告</span>
            </button>
            <button class="dock-nav-item" id="dockBtnBag" title="仓库">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M20 7h-4V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm-10-2h4v2h-4V5zm10 14H4V9h16v10z"/></svg>
              <span>仓库</span>
            </button>
            <button class="dock-nav-item" id="dockBtnWiki" title="图鉴 / BWiki 维基攻略">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span>图鉴</span>
            </button>
            <button class="dock-nav-item" id="dockBtnMail" title="邮件">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              <span>邮件</span>
            </button>
            <button class="dock-nav-item" id="dockBtnSettings" title="设置">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
              <span>设置</span>
            </button>
            <button class="dock-nav-item" id="dockBtnExit" title="退出">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
              <span>退出</span>
            </button>
          </nav>
        </footer>
      </section>

      <!-- 2. TOOLS VIEW (Replay Tool Integrated) -->
      <section id="toolsView" class="page-view tools-page hidden">
        <div class="tools-header">
          <div class="tools-title-group">
            <button class="back-btn" id="toolsBackHomeBtn">‹ 返回首页</button>
            <h2>对局回放分析工具</h2>
            <span class="tools-file-info" id="toolFileMeta">尚未打开回放文件</span>
          </div>
          <div class="tools-header-actions">
            <button class="secondary-btn hidden" id="toolLibraryBtn">回放列表</button>
            <button class="secondary-btn" id="toolExportBtn" disabled>导出 JSON</button>
            <button class="primary-btn" id="toolOpenBtn">＋ 打开回放</button>
          </div>
        </div>

        <!-- Replay Sub Navigation Tabs (Visible when replay is active) -->
        <div class="replay-subnav hidden" id="replaySubnav">
          <button class="subnav-tab active" data-tab="summary"><span>◈</span>对局摘要</button>
          <button class="subnav-tab" data-tab="players"><span>♙</span>玩家表现</button>
          <button class="subnav-tab" data-tab="timeline"><span>⌁</span>事件时间线</button>
          <button class="subnav-tab" data-tab="relics"><span>◆</span>筹码记录</button>
          <button class="subnav-tab" data-tab="technical"><span>▥</span>专业信息</button>
        </div>

        <div class="tools-workspace">
          <!-- Empty State / Recent Replays List -->
          <div class="replay-empty-state" id="replayEmptyBox">
            <div class="empty-icon-orbit">✦</div>
            <h3>把一局对战变成可读的数据</h3>
            <p>本地解析回放中的玩家、回合、动作、筹码流转与底层协议帧。所有数据均在本地安全离线处理。</p>
            <button class="primary-btn" id="emptySelectReplayBtn" style="padding:12px 28px;font-size:15px">选择回放文件</button>

            <div class="recent-replays-box">
              <div class="recent-head">
                <div>
                  <h4>本地回放缓存</h4>
                  <small id="libraryDirectoryText">正在检测 LocalLow 回放目录…</small>
                </div>
                <button class="secondary-btn" id="refreshLibraryBtn" style="padding:6px 14px;font-size:12px">刷新列表</button>
              </div>
              <div class="replay-entry-list" id="recentReplayList"></div>
            </div>
          </div>

          <!-- Active Replay Detail Workspace -->
          <div class="hidden" id="replayWorkspaceBox" style="height:100%">
            <div id="summaryView" class="replay-view"></div>
            <div id="playersView" class="replay-view hidden"></div>
            <div id="timelineView" class="replay-view hidden"></div>
            <div id="relicsView" class="replay-view hidden"></div>
            <div id="technicalView" class="replay-view hidden">
              <div style="display:flex;gap:10px;margin-bottom:18px">
                <button class="subnav-tab active" id="techTabStatistics">数据统计</button>
                <button class="subnav-tab" id="techTabProtocol">原始协议帧</button>
              </div>
              <div id="techStatsPane"></div>
              <div id="techProtocolPane" class="hidden"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. WIKI VIEW (Direct BWiki Webpage) -->
      <section id="wikiView" class="page-view wiki-page hidden">
        <div class="wiki-top-toolbar">
          <div class="wiki-toolbar-left">
            <button class="back-btn" id="wikiBackHomeBtn">‹ 返回首页</button>
            <div class="wiki-title-info">
              <h2>吉星派对 · BWiki 维基攻略</h2>
              <span class="wiki-url-badge">wiki.biligame.com/starengine</span>
            </div>
          </div>
          <div class="wiki-toolbar-right">
            <button class="secondary-btn" id="wikiRefreshBtn" title="重新载入维基页面">
              <span>↻</span> 刷新
            </button>
            <button class="primary-btn" id="wikiExternalBtn" title="在系统默认浏览器中打开">
              <span>↗</span> 浏览器打开
            </button>
          </div>
        </div>

        <div class="wiki-frame-container">
          <iframe
            id="wikiIframe"
            class="wiki-iframe"
            src="https://wiki.biligame.com/starengine/%E9%A6%96%E9%A1%B5"
            frameborder="0"
            allowfullscreen>
          </iframe>
        </div>
      </section>

      <!-- 4. SETTINGS VIEW -->
      <section id="settingsView" class="page-view settings-page hidden">
        <div class="settings-header">
          <h2>系统与设置</h2>
          <p>管理本地立绘资源、回放缓存目录与应用外观偏好</p>
        </div>

        <div class="settings-grid">
          <article class="settings-card">
            <div class="settings-card-head">
              <h3><span>🎨</span> 立绘与素材资源库</h3>
              <span class="status-tag-active" id="loadedPortraitsCount">已加载 122 张大立绘</span>
            </div>
            <div class="settings-field">
              <label>立绘素材路径与筛选规则</label>
              <div class="path-display-box">
                <span>C:\PublicFiles\materials\StarEngine\Grouped\人物立绘</span>
                <span class="badge badge-update">UT_Hero_Card_ 大立绘 · 排除 Card2 及 sfw</span>
              </div>
              <span class="field-desc">全量 1340×1692 高清大立绘已完成无损 WebP 内嵌打包，离线极速渲染。</span>
            </div>
            <div>
              <button class="secondary-btn" id="reloadPortraitsBtn">重新扫描素材库</button>
            </div>
          </article>

          <article class="settings-card">
            <div class="settings-card-head">
              <h3><span>📂</span> 游戏回放检索目录</h3>
              <span class="status-tag-active">自动检测</span>
            </div>
            <div class="settings-field">
              <label>LocalLow 回放缓存路径</label>
              <div class="path-display-box">
                <span id="settingsReplayDir">AppData\LocalLow\feimo\AstralParty_CN\Temp\Replay</span>
              </div>
              <span class="field-desc">对局结束后回放文件将自动保存至该目录，工具会自动列出最新回放。</span>
            </div>
          </article>

          <article class="settings-card">
            <div class="settings-card-head">
              <h3><span>✨</span> 界面与动画偏好</h3>
            </div>
            <div class="toggle-switch-row">
              <div class="toggle-info">
                <h4>立绘呼吸浮动动效</h4>
                <p>开启看板立绘的悬浮与呼吸光晕微动动画</p>
              </div>
              <input type="checkbox" class="switch-input" id="animToggle" checked>
            </div>
            <div class="toggle-switch-row">
              <div class="toggle-info">
                <h4>外观主题</h4>
                <p>当前使用为定制的高雅浅色二次元派对主题</p>
              </div>
              <span class="badge badge-notice">浅色外观</span>
            </div>
          </article>

          <article class="settings-card">
            <div class="settings-card-head">
              <h3><span>💻</span> 运行环境与兼容性</h3>
            </div>
            <div class="settings-field">
              <label>底层渲染引擎</label>
              <div class="path-display-box">
                <span>WPF · .NET 8.0 · Microsoft Edge WebView2</span>
              </div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;padding-top:6px">
              <span style="font-size:12px;color:var(--text-secondary)">若遇特殊显卡兼容性问题，可切换至原生界面：</span>
              <button class="secondary-btn" id="openClassicWpfBtn">切换原生 WPF 界面</button>
            </div>
          </article>
        </div>
      </section>
    </main>

    <!-- Global Modal Window -->
    <div class="modal-backdrop" id="globalModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3 id="modalTitle">公告详情</h3>
          <button class="modal-close-btn" id="modalCloseBtn">×</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
      </div>
    </div>

    <!-- Loading Overlay -->
    <div class="modal-backdrop hidden" id="loadingOverlay">
      <div style="background:#ffffff;padding:28px 36px;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px">
        <div style="width:36px;height:36px;border:3px solid #eef2fb;border-top-color:var(--primary);border-radius:50%;animation:spin 0.8s linear infinite"></div>
        <strong id="loadingText" style="font-size:15px;color:var(--text-main)">正在解析回放…</strong>
        <span style="font-size:12px;color:var(--text-muted)">全部处理都在本机离线完成</span>
      </div>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toast"></div>
  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

  <!-- Modular Scripts -->
  <script src="js/core.js"></script>
  <script src="js/home.js"></script>
  <script src="js/replay.js"></script>
  <script src="js/wiki.js"></script>
