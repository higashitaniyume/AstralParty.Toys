// home.js - Authentic In-Game Lobby Logic for Astral Party
(function () {
  const HomeModule = {
    init(data) {
      if (!data) return;
      this.announcements = data.announcements || [];
      this.pickDefaultFinnOrRandom();
      this.setupEventListeners();
    },

    onShowHome() {
      if (!AppState.currentPortrait && AppState.homeData?.portraits?.length) {
        this.pickDefaultFinnOrRandom();
      }
    },

    pickDefaultFinnOrRandom() {
      const portraits = AppState.homeData?.portraits;
      if (!portraits || !portraits.length) {
        this.applyPortrait({
          id: 'UT_Hero_Card_102_01',
          heroId: 102,
          heroName: '芬妮',
          title: '古怪神探',
          variant: '皮肤 01',
          url: 'https://assets.astral.local/Portraits/UT_Hero_Card_102_01.webp'
        });
        return;
      }

      // Look for Finn 102_01 as seen in the original screenshot
      const finn = portraits.find(p => p.id.toLowerCase() === 'ut_hero_card_102_01');
      if (finn && !AppState.currentPortrait) {
        AppState.currentPortrait = finn;
        this.applyPortrait(finn);
        this.triggerInteraction(false);
        return;
      }

      this.pickRandomPortrait();
    },

    setupEventListeners() {
      // 1. Primary Action: 开始游戏 -> Jump to Tools / Replay Analysis Tool
      $('btnStartGame')?.addEventListener('click', () => {
        showPage('tools');
      });

      // 2. Role / Hero -> Compendium / Wiki
      $('btnMenuRole')?.addEventListener('click', () => {
        showPage('wiki');
      });

      // 3. Shop Button & Banner
      $('btnMenuShop')?.addEventListener('click', () => this.showShopModal());
      $('btnBannerShop')?.addEventListener('click', () => this.showShopModal());

      // 4. Gacha / Lottery
      $('btnMenuGacha')?.addEventListener('click', () => this.showGachaModal());

      // 5. Activity Button & Left Event Badge
      $('btnMenuActivity')?.addEventListener('click', () => this.showAnnouncementsModal());
      $('btnEventTrial')?.addEventListener('click', () => this.showEventTrialModal());

      // 6. ClearPass Top-Left & Banner
      $('btnHomeClearPass')?.addEventListener('click', () => this.showClearPassModal());
      $('btnBannerPass')?.addEventListener('click', () => this.showClearPassModal());

      // 7. HUD View Controls
      $('btnToggleHud')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const home = $('homeView');
        if (home) {
          const isHidden = home.classList.toggle('hud-hidden');
          showToast(isHidden ? '已隐藏界面（点击右下角按钮恢复）' : '已恢复界面');
        }
      });

      $('btnResetView')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const img = $('heroPortraitImg');
        if (img) {
          img.style.transform = '';
          showToast('视角已重置');
        }
      });

      // 8. Fashion / Dress Button -> Switch Character Portrait
      $('btnSwitchHeroDress')?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.pickRandomPortrait();
        showToast(`已更换看板娘：${AppState.currentPortrait?.heroName || '角色'}`);
      });

      // 9. Portrait Click & Speech Bubble Click
      $('heroPortraitWrapper')?.addEventListener('click', (e) => {
        // If HUD is hidden, clicking screen restores HUD
        const home = $('homeView');
        if (home?.classList.contains('hud-hidden')) {
          home.classList.remove('hud-hidden');
          return;
        }
        this.triggerInteraction(true);
      });

      $('heroDialogBubble')?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.triggerInteraction(false);
      });

      // 10. Bottom Dock Bar Navigation
      $('dockBtnWiki')?.addEventListener('click', () => showPage('wiki'));
      $('dockBtnSettings')?.addEventListener('click', () => showPage('settings'));
      $('dockBtnNotice')?.addEventListener('click', () => this.showAnnouncementsModal());

      $('dockBtnTask')?.addEventListener('click', () => {
        showToast('任务系统：日常与周常对局任务同步已就绪');
      });

      $('dockBtnFriend')?.addEventListener('click', () => {
        showToast('好友系统：当前为离线工具模式');
      });

      $('dockBtnBag')?.addEventListener('click', () => {
        showToast('仓库系统：全部筹码与卡面已收录至对战工具');
      });

      $('dockBtnMail')?.addEventListener('click', () => {
        showToast('邮件箱：暂无未读系统邮件');
      });

      $('dockBtnExit')?.addEventListener('click', () => {
        if (confirm('是否退出吉星派对工具？')) {
          post({ type: 'closeWindow' });
        }
      });
    },

    pickRandomPortrait() {
      const portraits = AppState.homeData?.portraits;
      if (!portraits || !portraits.length) return;

      let candidate = portraits[Math.floor(Math.random() * portraits.length)];
      if (portraits.length > 1 && AppState.currentPortrait && candidate.id === AppState.currentPortrait.id) {
        candidate = portraits[Math.floor(Math.random() * portraits.length)];
      }

      AppState.currentPortrait = candidate;
      this.applyPortrait(candidate);
      this.triggerInteraction(false);
    },

    applyPortrait(item) {
      const img = $('heroPortraitImg');
      if (img) {
        img.style.opacity = '0';
        setTimeout(() => {
          img.src = item.url;
          img.alt = item.heroName;
          img.onload = () => {
            img.style.opacity = '1';
          };
          img.onerror = () => {
            img.src = `https://assets.astral.local/Characters/${item.heroId}.webp`;
            img.style.opacity = '1';
          };
        }, 120);
      }

      if ($('bubbleSpeakerName')) {
        $('bubbleSpeakerName').textContent = item.heroName;
      }
    },

    triggerInteraction(isClick) {
      const p = AppState.currentPortrait;
      const data = AppState.homeData;
      if (!data) return;

      let line = '';
      if (isClick && data.clickReactions?.length) {
        line = data.clickReactions[Math.floor(Math.random() * data.clickReactions.length)];
      } else {
        const heroLines = p && data.heroGreetings?.[p.heroId];
        if (heroLines && heroLines.length && Math.random() > 0.35) {
          line = heroLines[Math.floor(Math.random() * heroLines.length)];
        } else if (data.greetings?.length) {
          line = data.greetings[Math.floor(Math.random() * data.greetings.length)];
        }
      }

      const bubbleText = $('bubbleSpeechText');
      if (bubbleText) {
        bubbleText.style.opacity = '0.3';
        bubbleText.style.transform = 'translateY(2px)';
        setTimeout(() => {
          bubbleText.textContent = line;
          bubbleText.style.opacity = '1';
          bubbleText.style.transform = 'translateY(0)';
        }, 100);
      }
    },

    showAnnouncementsModal() {
      const list = this.announcements;
      if (!list.length) {
        showToast('暂无最新公告');
        return;
      }

      const html = `
        <div style="display:flex;flex-direction:column;gap:14px;max-height:65vh;overflow-y:auto;padding-right:6px">
          ${list.map(item => `
            <article class="announcement-card" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(0,0,0,0.04)">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <span class="badge ${esc(item.tagClass)}">${esc(item.category)}</span>
                <span style="font-size:12px;color:#94a3b8">${esc(item.date)}</span>
              </div>
              <h4 style="margin:0 0 6px;font-size:15px;color:#1e293b">${esc(item.title)}</h4>
              <p style="margin:0;font-size:13px;line-height:1.6;color:#64748b">${esc(item.summary)}</p>
            </article>
          `).join('')}
        </div>
      `;

      openModal('📢 游戏官方公告与活动一览', html);
    },

    showClearPassModal() {
      openModal('🎟️ 小红帽通行证 CLEARPASS', `
        <div style="text-align:center;padding:10px">
          <img src="https://assets.astral.local/UI/UT_BattlePass_202609_EntranceUnfold.webp" style="max-width:100%;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15)">
          <h3 style="margin:16px 0 6px;color:#e11d48">全新通行证赛季现已开启</h3>
          <p style="font-size:13.5px;color:#64748b;line-height:1.6">完成每日活跃度对局与升级任务，即可解锁限定「小红帽」主题名片、专属骰子皮肤与丰富星币奖励！</p>
        </div>
      `);
    },

    showShopModal() {
      openModal('🛍️ 魔女商店 (09.03 - 10.14)', `
        <div style="text-align:center;padding:10px">
          <img src="https://assets.astral.local/UI/UT_Banner_609030.webp" style="max-width:100%;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.15)">
          <h3 style="margin:16px 0 6px;color:#0284c7">限时庆典商店开放</h3>
          <p style="font-size:13.5px;color:#64748b;line-height:1.6">使用对局获得的星辉代币与星晶，可自由兑换高级筹码礼包、专属头像框与角色定制装扮！</p>
        </div>
      `);
    },

    showGachaModal() {
      openModal('✨ 星之抽奖 UP!', `
        <div style="text-align:center;padding:10px">
          <div style="font-size:48px;margin-bottom:8px">🎲</div>
          <h3 style="margin:0 0 8px;color:#7c3aed">本期概率提升角色</h3>
          <p style="font-size:13.5px;color:#64748b;line-height:1.6">活动限定角色与专属传说筹码抽取概率大幅提升！快投掷幸运骰子开启属于你的派对冒险吧～</p>
        </div>
      `);
    },

    showEventTrialModal() {
      openModal('🔮 魔法少女的魔女审判', `
        <div style="text-align:center;padding:10px">
          <img src="https://assets.astral.local/UI/UT_Activity_202609031_Entrance.webp" style="width:120px;height:120px;border-radius:50%;border:3px solid #38bdf8;box-shadow:0 6px 20px rgba(56,189,248,0.4)">
          <h3 style="margin:16px 0 6px;color:#0369a1">【特别活动】魔法少女的魔女审判</h3>
          <p style="font-size:13.5px;color:#64748b;line-height:1.6">活动时间：09.03 - 10.14<br>参与全新机制棋盘试炼，挑战限定魔女Boss，达成成就赢取独家纪念称号！</p>
        </div>
      `);
    }
  };

  window.HomeModule = HomeModule;
})();
