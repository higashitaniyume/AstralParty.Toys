<Window x:Class="AstralParty.Toys.HybridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AstralParty.Toys · 吉星派对工具箱"
        Width="1480" Height="920" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB"
        Loaded="Window_Loaded">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#F3F6FB" />
        <Border x:Name="StartupOverlay" Background="#F3F6FB">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✦" Foreground="#7766D7" FontSize="54" HorizontalAlignment="Center" />
                <TextBlock Text="正在启动回放工具…" Foreground="#263248" FontSize="18" Margin="0,18,0,0" />
                <TextBlock x:Name="StartupDetail" Text="准备本地界面" Foreground="#75839A" Margin="0,8,0,0" />
                <ProgressBar IsIndeterminate="True" Width="280" Height="4" Margin="0,24,0,0" Foreground="#7766D7" />
                <Button x:Name="ClassicButton" Content="使用备用界面" Visibility="Collapsed" Margin="0,24,0,0"
                        Padding="18,9" Click="ClassicButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
