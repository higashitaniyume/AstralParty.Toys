{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstralParty.Toys for Linux",
  "identifier": "com.github.higashitaniyume.astralparty-toys-linux",
  "build": { "frontendDist": "generated/webui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "AstralParty.Toys · Linux", "create": false, "width": 1040, "height": 720, "minWidth": 640, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [{ "identifier": "overview", "windows": ["main"], "permissions": ["allow-host-message"] }]
    }
  },
  "bundle": { "active": false, "icon": ["../src/AstralParty.Toys/WebUI/images/astralparty-game-icon.png"] }
}
